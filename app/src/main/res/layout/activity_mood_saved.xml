<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/background"
    android:padding="28dp">

    <TextView android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✅"
        android:textSize="64sp"
        android:layout_marginBottom="8dp"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mood Saved!"
        android:textColor="@color/textDark"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView android:id="@+id/tvSavedEmoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="😊"
        android:textSize="56sp"
        android:layout_marginBottom="8dp"/>
    <TextView
        android:id="@+id/tvSavedLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Feeling Good"
        android:textColor="@color/primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvSavedTags"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text=""
        android:textColor="@color/textGray"
        android:textSize="13sp" />

    <TextView android:id="@+id/tvStreakUpdate" android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔥 Streak updating..."
        android:textColor="@color/accent"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="@drawable/bg_card_light"
        android:padding="12dp"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btnViewHistory"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_button_primary"
        android:text="📅 View Mood History"
        android:textColor="@color/white"
        android:textSize="15sp" android:textStyle="bold"
        android:stateListAnimator="@null" android:layout_marginBottom="12dp"/>

    <Button android:id="@+id/btnGoHome"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_card_outline"
        android:text="🏠 Go to Home"
        android:textColor="@color/textDark"
        android:textSize="15sp"
        android:stateListAnimator="@null"/>

</LinearLayout>
