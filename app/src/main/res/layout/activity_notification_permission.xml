<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="28dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔔"
        android:textSize="80sp"
        android:layout_marginBottom="32dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Stay Mindful &amp; Connected"
        android:textColor="@color/textDark"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enable notifications to receive daily mood check-ins, reminders to breathe, and custom wellness tips. You can change this anytime in settings."
        android:textColor="@color/textGray"
        android:textSize="14sp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.3"
        android:layout_marginBottom="48dp"/>

    <Button
        android:id="@+id/btnAllow"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_button_primary"
        android:text="Allow Notifications"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:stateListAnimator="@null"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnLater"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_card_outline"
        android:text="Maybe Later"
        android:textColor="@color/textDark"
        android:textSize="15sp"
        android:stateListAnimator="@null"/>

</LinearLayout>
