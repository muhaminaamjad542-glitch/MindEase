<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="28dp" android:background="@color/background">

    <ImageButton android:id="@+id/btnBack" android:layout_width="40dp" android:layout_height="40dp"
        android:background="@drawable/circle_gray" android:src="@android:drawable/ic_media_previous"
        android:contentDescription="Back" android:layout_marginTop="12dp" android:layout_marginBottom="24dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="New Password" android:textColor="@color/textDark" android:textSize="24sp"
        android:textStyle="bold" android:layout_marginBottom="8dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Create a strong, unique password." android:textColor="@color/textGray"
        android:textSize="14sp" android:layout_marginBottom="28dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="New Password" android:textColor="@color/textDark" android:textSize="13sp"
        android:textStyle="bold" android:layout_marginBottom="6dp"/>
    <EditText android:id="@+id/etPassword" android:layout_width="match_parent" android:layout_height="52dp"
        android:background="@drawable/bg_input_field" android:hint="Enter new password"
        android:inputType="textPassword" android:paddingHorizontal="16dp"
        android:textColor="@color/textDark" android:textColorHint="@color/textGray"
        android:layout_marginBottom="12dp"/>

    <ProgressBar
        android:id="@+id/strengthBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="8dp"
        android:max="100" android:progress="0"
        android:progressTint="@color/primary"
        android:layout_marginBottom="4dp"/>
    <TextView android:id="@+id/tvStrength" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="" android:textSize="12sp" android:layout_marginBottom="16dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Confirm Password" android:textColor="@color/textDark" android:textSize="13sp"
        android:textStyle="bold" android:layout_marginBottom="6dp"/>
    <EditText android:id="@+id/etConfirmPassword" android:layout_width="match_parent" android:layout_height="52dp"
        android:background="@drawable/bg_input_field" android:hint="Re-enter password"
        android:inputType="textPassword" android:paddingHorizontal="16dp"
        android:textColor="@color/textDark" android:textColorHint="@color/textGray"
        android:layout_marginBottom="24dp"/>

    <Button android:id="@+id/btnReset" android:layout_width="match_parent" android:layout_height="52dp"
        app:backgroundTint="@color/primary" app:cornerRadius="28dp" android:text="Update Password"
        android:textColor="@android:color/white" android:textSize="16sp" android:textStyle="bold"
        android:stateListAnimator="@null"/>

</LinearLayout>
