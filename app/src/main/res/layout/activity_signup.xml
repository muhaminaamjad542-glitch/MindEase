<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create Account"
            android:textColor="@color/textDark"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start your wellness journey today"
            android:textColor="@color/textGray"
            android:textSize="14sp"
            android:layout_marginBottom="28dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Full Name" android:textColor="@color/textDark" android:textSize="13sp"
            android:textStyle="bold" android:layout_marginBottom="6dp"/>
        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:background="@drawable/bg_input_field" android:hint="Enter your full name"
            android:inputType="textPersonName" android:paddingHorizontal="16dp"
            android:textColor="@color/textDark" android:textColorHint="@color/textGray"
            android:layout_marginBottom="16dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Age" android:textColor="@color/textDark" android:textSize="13sp"
            android:textStyle="bold" android:layout_marginBottom="6dp"/>
        <EditText
            android:id="@+id/etAge"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:background="@drawable/bg_input_field" android:hint="Enter your age"
            android:inputType="number" android:paddingHorizontal="16dp"
            android:textColor="@color/textDark" android:textColorHint="@color/textGray"
            android:layout_marginBottom="16dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Email" android:textColor="@color/textDark" android:textSize="13sp"
            android:textStyle="bold" android:layout_marginBottom="6dp"/>
        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:background="@drawable/bg_input_field" android:hint="Enter your email"
            android:inputType="textEmailAddress" android:paddingHorizontal="16dp"
            android:textColor="@color/textDark" android:textColorHint="@color/textGray"
            android:layout_marginBottom="16dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Password" android:textColor="@color/textDark" android:textSize="13sp"
            android:textStyle="bold" android:layout_marginBottom="6dp"/>
        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:background="@drawable/bg_input_field" android:hint="At least 6 characters"
            android:inputType="textPassword" android:paddingHorizontal="16dp"
            android:textColor="@color/textDark" android:textColorHint="@color/textGray"
            android:layout_marginBottom="16dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Confirm Password" android:textColor="@color/textDark" android:textSize="13sp"
            android:textStyle="bold" android:layout_marginBottom="6dp"/>
        <EditText
            android:id="@+id/etConfirmPassword"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:background="@drawable/bg_input_field" android:hint="Re-enter password"
            android:inputType="textPassword" android:paddingHorizontal="16dp"
            android:textColor="@color/textDark" android:textColorHint="@color/textGray"
            android:layout_marginBottom="16dp"/>

        <CheckBox
            android:id="@+id/cbTerms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="I agree to the Terms &amp; Privacy Policy"
            android:textColor="@color/textGray"
            android:textSize="13sp"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnSignup"
            android:layout_width="match_parent" android:layout_height="52dp"
            app:backgroundTint="@color/primary" app:cornerRadius="28dp" android:text="Create Account"
            android:textColor="@android:color/white" android:textSize="16sp" android:textStyle="bold"
            android:stateListAnimator="@null" android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="— or continue with —"
            android:textColor="@color/textGray"
            android:textSize="12sp"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnGoogleSignup"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_card_outline"
            android:text="🔵  Sign up with Google"
            android:textColor="@color/textDark"
            android:textSize="15sp"
            android:stateListAnimator="@null"
            android:layout_marginBottom="24dp"/>

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:orientation="horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Already have an account? " android:textColor="@color/textGray" android:textSize="14sp"/>
            <TextView
                android:id="@+id/tvLogin"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Log In" android:textColor="@color/primary" android:textSize="14sp"
                android:textStyle="bold"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
